PUID=1000
PGID=1000
SUBGEN_IMAGE=ghcr.io/fahed-alhammadi/subgen:latest
SUBGEN_BIND_ADDRESS=127.0.0.1
SUBGEN_PORT=8080
SUBGEN_CONFIG_PATH=./data/config
SUBGEN_MODEL_PATH=./data/models
SUBGEN_MEDIA_PATH=./media

# Required. Change both before starting. Password: 12+ chars; key: 32+ chars.
SUBGEN_ADMIN_USERNAME=admin
SUBGEN_ADMIN_PASSWORD=replace-with-a-long-unique-password
SUBGEN_SECRET_KEY=replace-with-at-least-32-random-characters
SUBGEN_SECURE_COOKIES=true
SUBGEN_SESSION_HOURS=24
SUBGEN_LOGIN_ATTEMPTS=5
SUBGEN_LOGIN_WINDOW_SECONDS=300
SUBGEN_TRUSTED_PROXIES=127.0.0.1

# Two-factor sign-in is turned on from Settings > Security in the web UI.
# Optional override: a Base32 secret here enforces it and hides the on/off switch.
# SUBGEN_TOTP_SECRET=

SUBGEN_WHISPER_DEVICE=auto
SUBGEN_WHISPER_COMPUTE_TYPE=auto
# Models are chosen on the Models page. On first start SubGen installs the defaults
# (Whisper Small and NLLB-200 600M, about 3 GB). Set false on servers without internet.
SUBGEN_AUTO_INSTALL_MODELS=true
SUBGEN_LOG_LEVEL=INFO

# Studio uploads (drag-and-drop files in the web UI). Stored under /config/workspace by default.
SUBGEN_MAX_UPLOAD_MB=20480
# SUBGEN_WORKSPACE_DIR=/config/workspace

# Seconds a file must stay unchanged before it is processed (protects files still being copied).
SUBGEN_STABLE_FILE_SECONDS=60

