# User that owns your media folders. Find it with: id -u  and  id -g
PUID=1000
PGID=1000

# Admin sign-in. Password: at least 12 characters.
SUBGEN_ADMIN_USERNAME=admin
SUBGEN_ADMIN_PASSWORD=change-me-to-a-long-password

# Everything else is optional and has a sensible default. Most options live in the web
# interface under Settings.

# Behind a reverse proxy in another container: the proxy's address or Docker network range.
# SUBGEN_TRUSTED_PROXIES=172.18.0.0/16

# Signs sign-in cookies. Generated automatically and kept in config/secret_key when not set.
# SUBGEN_SECRET_KEY=

# Forces two-factor sign-in with this Base32 secret. Otherwise turn it on in Settings > Security.
# SUBGEN_TOTP_SECRET=

# On first start SubGen downloads the default models (about 3 GB). Set false on servers
# without internet and install models from the Models page instead.
# SUBGEN_AUTO_INSTALL_MODELS=false
